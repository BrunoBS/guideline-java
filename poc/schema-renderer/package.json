{
  "name": "schema-renderer-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build --configuration production",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "build:development": "ng build --configuration development",
    "typecheck": "ngc --noEmit -p tsconfig.app.json",
    "check": "npm run format:check && npm run test && npm run typecheck && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check:all": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "rxjs": "~7.8.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
