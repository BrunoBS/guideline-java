{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "workspace-mfe": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "wm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/workspace-mfe",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css"
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "workspace-mfe:build"
          }
        }
      }
    }
  },
  "defaultProject": "workspace-mfe"
}